{
  "name": "adulis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run check:i18n && npm run check:encoding && npm run check:font && npm run check:copy && npm run check:assets && npm run check:env",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "qa": "playwright test",
    "qa:report": "playwright show-report",
    "check:font": "node scripts/check-font.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "qa:snapshots": "node scripts/snapshot-container.mjs",
    "qa:snapshots:update": "node scripts/snapshot-container.mjs --update"
  },
  "dependencies": {
    "next": "15.5.23",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
