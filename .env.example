# The domain is not yet decided. Until it is, leave NEXT_PUBLIC_SITE_URL unset in
# any real environment: the layout emits `robots: noindex, nofollow` whenever it is
# missing, which is what keeps a pre-launch build out of search results.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where waitlist submissions are delivered. Without this, a submission is written
# to the server console only -- the applicant still sees their reference number,
# but nobody receives the application.
WAITLIST_WEBHOOK_URL=

# Contact form delivery. Not yet wired: /contact is a Tier 2 stub.
CONTACT_WEBHOOK_URL=
