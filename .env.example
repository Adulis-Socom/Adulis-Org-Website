# The domain is not yet decided. Until it is, leave NEXT_PUBLIC_SITE_URL unset in
# any real environment: the layout emits `robots: noindex, nofollow` whenever it is
# missing, which is what keeps a pre-launch build out of search results.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where waitlist submissions are delivered. REQUIRED for a deployable build --
# `npm run build` refuses without it, because the waitlist is the only conversion
# on this site and a build that cannot deliver is not deployable.
#
# Must be https (localhost is allowed for local testing). Submissions carry names
# and phone numbers.
#
# With it unset, the waitlist REJECTS every submission in production rather than
# issuing a reference number for an application nobody receives. In development it
# returns a reference prefixed DEV-NOT-DELIVERED so it cannot be mistaken for one.
WAITLIST_WEBHOOK_URL=

# Escape hatch for local builds with no delivery destination. Explicit and
# visible in the command, never a default:
#     ALLOW_UNDELIVERED_WAITLIST=1 npm run build
# Do not set this in CI or on a deployed environment.
# ALLOW_UNDELIVERED_WAITLIST=

# Contact form delivery. Not yet wired: /contact is a Tier 2 stub.
CONTACT_WEBHOOK_URL=
